# Configure these values in Vercel. Never expose OPENAI_API_KEY in the browser.

# Chave da conta de API (platform.openai.com), com credito. Nao e o ChatGPT Plus.
OPENAI_API_KEY=

# Precisa aceitar: endpoint v1/responses, structured outputs e imagem na entrada.
# Sugestao (mais barato que atende os tres): gpt-5.6-luna
OPENAI_MODEL=

# Senha que voce inventa, so para o site aceitar pedidos seus. Nao vem de lugar nenhum.
APP_ACCESS_TOKEN=
