# Configure these values in Vercel. Never expose GEMINI_API_KEY in the browser.

# Chave do Google AI Studio (aistudio.google.com/apikey). O nivel gratuito
# nao pede cartao. Atencao: no nivel gratuito o Google usa o conteudo
# enviado para melhorar os produtos deles.
GEMINI_API_KEY=

# Opcional. Padrao: gemini-3.1-flash-lite
# Precisa aceitar imagem na entrada e responseSchema.
GEMINI_MODEL=

# Senha que voce inventa, so para o site aceitar pedidos seus. Nao vem de lugar nenhum.
APP_ACCESS_TOKEN=

# --- Conta e sincronizacao entre aparelhos (opcional) ---
# Sem estas variaveis o app funciona igual, guardando so no navegador: o login
# some da tela e /api/diario responde 503. Nada quebra.

# Credencial OAuth do Google Cloud. O URI de redirecionamento cadastrado la
# precisa ser https://SEU-SITE/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Assina o cookie de sessao. Gere com: npx auth secret
# Use o mesmo valor nos tres ambientes, senao as sessoes caem a cada troca.
AUTH_SECRET=

# Postgres (Neon pela aba Storage da Vercel). A Vercel injeta sozinha ao
# conectar o banco ao projeto. Sem ela, o login funciona mas nao sincroniza.
# Antes do primeiro uso, rode o SQL de drizzle/0000_*.sql no banco.
DATABASE_URL=

# So fora da Vercel. La o host e confiado automaticamente; em outro servidor,
# sem isto o Auth.js recusa com UntrustedHost.
AUTH_TRUST_HOST=
